# Copy this file to .env and fill in your local signing/notarization values.
# .env is ignored by git and must not be committed.

# Get this from https://account.apple.com/account/manage
APP_SPECIFIC_PASSWORD=app-specific-password

# Preferred spelling. APPPLE_ID is also supported for compatibility.
APPLE_ID=your-apple-id@example.com
# APPPLE_ID=your-apple-id@example.com

NOTARY_PROFILE=statusbarip-notary
REQUIRE_NOTARIZATION=1

# Optional. Leave SIGNING_IDENTITY=auto to use the first Developer ID Application
# certificate found in Keychain. You can also use a SHA-1 fingerprint from:
# security find-identity -v -p codesigning
SIGNING_IDENTITY=auto
